---
interface Props {
  index: string
  stack: string
  title: string
  description: string
  href: string
}

const { index, stack, title, description, href } = Astro.props
const titleParts = title.split("→").map((part) => part.trim())
const isExternal = href.startsWith("http")
const label = isExternal
  ? `Ver detalle de ${title}, se abre en una pestaña nueva`
  : `Ver detalle de ${title}`
---

<style>
  .proyecto-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
    min-height: 100%;
    padding: 21px;
    background: var(--color-white);
    border: var(--border-width) solid color-mix(in srgb, var(--color-border) 90%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: 2px 2px 0 0 var(--color-text-primary);
    transition:
      transform var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .proyecto-card:hover,
  .proyecto-card:focus-within {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 0 var(--color-text-primary);
  }

  .proyecto-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .proyecto-card__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 24px;
    padding: 0 6px;
    background: var(--color-accent);
    color: var(--color-white);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 16px;
    border-radius: 6px;
  }

  .proyecto-card__stack {
    padding: 3px 11px;
    background: var(--color-surface-muted);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    line-height: 16.5px;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .proyecto-card__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: -0.45px;
    color: var(--color-text-primary);
  }

  .proyecto-card__title-arrow {
    color: var(--color-accent);
  }

  .proyecto-card__copy {
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 12px;
    line-height: 19.5px;
    color: var(--color-text-secondary);
  }

  .proyecto-card__footer {
    margin-top: var(--space-16);
    padding-top: 13px;
    border-top: var(--border-width) solid #f5f5f4;
  }

  .proyecto-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-accent);
    width: fit-content;
    transition:
      gap var(--duration) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .proyecto-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .proyecto-card__link:hover,
  .proyecto-card__link:focus-visible {
    opacity: 0.85;
    gap: var(--space-8);
    color: var(--color-accent);
  }

  .proyecto-card__link:active {
    transform: scale(0.98);
  }

  @media (min-width: 769px) {
    .proyecto-card {
      padding: 26px;
      border: 2px solid #1e1e24;
      border-radius: var(--radius-md);
      box-shadow: 3px 3px 0 0 var(--color-text-primary);
    }

    .proyecto-card:hover,
    .proyecto-card:focus-within {
      transform: translate(-3px, -3px);
      box-shadow: 6px 6px 0 0 var(--color-text-primary);
    }

    .proyecto-card__meta {
      margin-bottom: 0;
    }

    .proyecto-card__index {
      min-width: unset;
      height: auto;
      padding: 2px 8px;
      background: #dc2626;
      font-family: var(--font-jetbrains);
      border-radius: 4px;
    }

    .proyecto-card__stack {
      padding: 3px 9px;
      background: #fafafa;
      border-color: #1e1e24;
      font-family: var(--font-jetbrains);
      font-size: 12px;
      line-height: 16px;
      color: var(--color-text-primary);
    }

    .proyecto-card__title {
      margin-top: 9px;
      font-size: 20px;
      letter-spacing: 0;
    }

    .proyecto-card__title-arrow {
      color: inherit;
    }

    .proyecto-card__copy {
      margin-top: 0;
      font-size: 14px;
      line-height: 22.75px;
      color: #585860;
    }

    .proyecto-card__footer {
      margin-top: var(--space-24);
      padding-top: 25px;
      border-top-color: #f5f5f5;
    }

    .proyecto-card__link {
      font-family: var(--font-hand);
      font-size: 18px;
      line-height: 28px;
      color: #dc2626;
    }

    .proyecto-card__link:hover,
    .proyecto-card__link:focus-visible {
      color: #dc2626;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proyecto-card,
    .proyecto-card__link {
      transition: none;
    }

    .proyecto-card:hover,
    .proyecto-card:focus-within,
    .proyecto-card__link:active {
      transform: none;
    }
  }
</style>

<article class="proyecto-card">
  <div class="proyecto-card__body">
    <div class="proyecto-card__meta">
      <span class="proyecto-card__index">{index}</span>
      <span class="proyecto-card__stack">{stack}</span>
    </div>
    <h3 class="proyecto-card__title">
      {
        titleParts.length > 1 ? (
          <>
            {titleParts[0]}
            <span class="proyecto-card__title-arrow"> → </span>
            {titleParts.slice(1).join(" → ")}
          </>
        ) : (
          title
        )
      }
    </h3>
    <p class="proyecto-card__copy">{description}</p>
  </div>
  <div class="proyecto-card__footer">
    <a
      class="proyecto-card__link"
      href={href}
      aria-label={label}
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
    >
      <span>ver detalle</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
