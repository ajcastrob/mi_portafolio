---
const { titleBadge, variant, iconStack } = Astro.props
---

<style>
  .home-hero__badge {
    display: flex;
    align-items: center;
    gap: 5px;
    width: auto;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Variantes - Mobile */
  .home-hero__badge--comunicacion,
  .home-hero__badge--django,
  .home-hero__badge--python,
  .home-hero__badge--astro,
  .home-hero__badge--n8n,
  .home-hero__badge--react {
    background-color: var(--color-surface-warm);
    font-weight: 600;
    color: var(--color-text-primary);
  }


  .header__toggle-icon {
    width: var(--font-size-body);
    height: var(--font-size-body);
    border-radius: 50%;
  }


  @media (min-width: 769px) {
    .home-hero__badge {
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 4px 14px;
      background-color: var(--color-white);
      border: var(--border-width) solid var(--color-border);
    }
  }
</style>

<div class:list={["home-hero__badge", variant && `home-hero__badge--${variant}`]}>
  {titleBadge}
  <svg class="header__toggle-icon" aria-hidden="true" focusable="false" viewBox="0 0 50 50" >
    <use href={iconStack}></use>
  </svg>
</div>
