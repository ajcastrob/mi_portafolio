---
import { Image } from "astro:assets"
import personal from "@/assets/personal.webp"
import Badge from "@/components/badge/Badge.astro"

const djangoIcon = "/assets/icons/stack.svg#django"
const astroIcon = "/assets/icons/stack.svg#astro"
const n8nIcon = "/assets/icons/stack.svg#n8n"
---

<style>
  .home-hero {
    width: 100%;
    max-width: 100%;
    padding: var(--space-32) var(--space-24) var(--space-48);
  }

  .home-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  .home-hero__figure {
    position: relative;
    width: min(11rem, 72vw);
    margin: 0 0 var(--space-32);
    padding: 14px 12px 18px;
    background: var(--color-white);
    border-radius: var(--radius);
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.05),
      0 20px 35px rgba(44, 30, 20, 0.18);
    transform: rotate(-1.6deg);
  }

  .home-hero__washi {
    position: absolute;
    top: -8px;
    right: -16px;
    width: 5.5rem;
    height: 22px;
    background: color-mix(in srgb, var(--color-washi) 82%, transparent);
    border-radius: var(--radius);
    transform: rotate(18deg);
    pointer-events: none;
  }

  .home-hero__image-wrap {
    background: var(--color-surface-muted);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .home-hero__figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__caption {
    margin-top: 10px;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .home-hero__kicker {
    margin: 0 0 var(--space-12);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--color-accent);
  }

  .home-hero__title {
    margin: 0 auto;
    max-width: 16ch;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2rem, 1.2rem + 3.2vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .home-hero__copy {
    margin: var(--space-24) auto 0;
    max-width: 36ch;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .home-hero__copy p {
    margin: 0;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-16);
    margin-top: var(--space-32);
  }

  .home-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    background: var(--color-accent);
    color: var(--color-white);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sello);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color var(--duration) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .home-hero__cta:hover,
  .home-hero__cta:focus-visible {
    background: var(--color-accent-deep);
    color: var(--color-white);
  }

  .home-hero__cta:active {
    transform: scale(0.98);
  }

  .home-hero__alt {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .home-hero__alt:hover,
  .home-hero__alt:focus-visible {
    color: var(--color-accent);
  }

  .home-hero__stamps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-8);
    margin-top: var(--space-32);
  }

  .home-hero__stamps :global(.home-hero__badge) {
    display: inline-flex;
    width: auto;
  }

  @media (min-width: 769px) {
    .home-hero {
      padding: var(--space-40) var(--space-40) var(--space-64);
    }

    .home-hero__figure {
      width: 11rem;
    }

    .home-hero__kicker {
      font-size: 1.875rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero__figure {
      animation: hero-settle 0.8s var(--ease-out) both;
    }
  }

  @keyframes hero-settle {
    from {
      transform: rotate(-1.6deg) translateY(12px);
    }
    to {
      transform: rotate(-1.6deg) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__cta,
    .home-hero__cta:active {
      transition: none;
      transform: none;
    }
  }
</style>

<section class="home-hero" id="home-hero">
  <div class="home-hero__inner">
    <figure class="home-hero__figure">
      <span class="home-hero__washi" aria-hidden="true"></span>
      <div class="home-hero__image-wrap">
        <Image
          src={personal}
          alt="Fotografía de José Castro"
          widths={[320, 480, 680]}
          sizes="176px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="home-hero__caption">Código &amp; Contenidos</figcaption>
    </figure>

    <p class="home-hero__kicker">Software + comunicación</p>
    <h1 class="home-hero__title">Construyo webs que tu equipo puede mantener.</h1>
    <div class="home-hero__copy">
      <p>
        Comunicador y desarrollador freelance. Hago herramientas que la gente usa.
      </p>
    </div>

    <div class="home-hero__actions">
      <a class="home-hero__cta" href="/#contacto">Escríbeme</a>
      <a class="home-hero__alt" href="/#proyectos">Ver proyectos ↓</a>
    </div>

    <div class="home-hero__stamps">
      <Badge titleBadge="Django" variant="django" iconStack={djangoIcon} />
      <Badge titleBadge="Astro" variant="astro" iconStack={astroIcon} />
      <Badge titleBadge="n8n" variant="n8n" iconStack={n8nIcon} />
    </div>
  </div>
</section>
