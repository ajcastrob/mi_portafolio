---
const { linkLogo } = Astro.props
---

<style>
  .header__brand{
    display: flex;
    width: 130px;
    min-height: 44px;
    height: 44px;
    background: var(--color-white);
    flex-direction: column;
    padding: 8.5px 12px 7.5px 12px;
    align-items: flex-start;
    border-radius: var(--radius);
    border: var(--radius) solid var(--color-text-primary);
    box-shadow: var(--shadow-sello);
  }

  .header__logo {
    width: 100px;
    height: 100px;
    }    
</style>


<a class="header__brand" href="/" aria-label="ajcastrob, inicio">
  <svg class="header__logo" aria-hidden="true" focusable="false">
    <use href={linkLogo}></use>
  </svg>
</a>


