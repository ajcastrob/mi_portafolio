---
---

<style>
  .contact-form {
    width: 100%;
    max-width: 100%;
    scroll-margin-top: 80px;
    background: var(--color-surface);
  }

  .contact-form__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
    max-width: var(--max-width-content);
    margin-inline: auto;
    padding: var(--space-32) var(--space-24);
  }

  .contact-form__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .contact-form__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--font-size-label);
    line-height: 16.5px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: #a8a29e;
  }

  .contact-form__hook {
    margin: 0;
    max-width: 20ch;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    color: var(--color-accent);
  }

  .contact-form__lede {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-secondary);
  }

  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    padding: 21px;
    background: var(--color-white);
    border: var(--border-width) solid color-mix(in srgb, var(--color-border) 90%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: 2px 2px 0 0 var(--color-text-primary);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    width: 100%;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    min-width: 0;
  }

  .contact-form__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-form__label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--font-size-label);
    line-height: 16.5px;
    letter-spacing: 0.275px;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  .contact-form__control,
  .contact-form__textarea {
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 9px 13px 10px;
    background: var(--color-surface-muted);
    border: var(--border-width) solid var(--color-border);
    border-radius: 6px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-primary);
    appearance: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .contact-form__textarea {
    min-height: 66px;
    resize: vertical;
  }

  .contact-form__control::placeholder,
  .contact-form__textarea::placeholder {
    color: #a8a29e;
  }

  .contact-form__control:hover,
  .contact-form__textarea:hover {
    border-color: color-mix(in srgb, var(--color-text-primary) 35%, var(--color-border));
  }

  .contact-form__control:focus,
  .contact-form__textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: var(--color-white);
  }

  .contact-form__field.is-invalid .contact-form__control,
  .contact-form__field.is-invalid .contact-form__textarea,
  .contact-form__control:user-invalid,
  .contact-form__textarea:user-invalid {
    border-color: var(--color-accent);
  }

  .contact-form__error {
    display: none;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-accent);
  }

  .contact-form__field.is-invalid .contact-form__error {
    display: block;
  }

  .contact-form__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    padding-top: 4px;
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    width: 100%;
    padding: 10px 16px;
    background: var(--color-accent);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 1px color-mix(in srgb, var(--color-accent) 25%, transparent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.3px;
    color: var(--color-white);
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .contact-form__submit:hover,
  .contact-form__submit:focus-visible {
    background: var(--color-accent-soft);
    color: var(--color-white);
  }

  .contact-form__submit:active {
    transform: scale(0.98);
  }

  .contact-form__submit:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  .contact-form__arrow {
    font-family: var(--font-mono);
  }

  @media (min-width: 769px) {
    .contact-form {
      background: transparent;
      padding-inline: var(--space-40);
      margin-bottom: var(--space-64);
    }

    .contact-form__inner {
      gap: 40px;
      padding: 49px;
      background: color-mix(in srgb, var(--color-white) 85%, transparent);
      border: var(--border-width) solid #1e1e24;
      border-radius: 16px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .contact-form__header {
      gap: var(--space-8);
      max-width: 576px;
      margin-inline: auto;
    }

    .contact-form__kicker {
      font-family: var(--font-jetbrains);
      font-size: 12px;
      line-height: 16px;
      letter-spacing: 1.2px;
      color: var(--color-text-primary);
    }

    .contact-form__hook {
      max-width: none;
      font-size: 36px;
      line-height: 40px;
      color: #dc2626;
    }

    .contact-form__lede {
      display: none;
    }

    .contact-form__form {
      gap: var(--space-24);
      max-width: 672px;
      margin-inline: auto;
      padding: 0;
      background: transparent;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }

    .contact-form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-24);
    }

    .contact-form__field {
      gap: var(--space-8);
    }

    .contact-form__label {
      font-family: var(--font-jetbrains);
      font-weight: 600;
      font-size: 12px;
      line-height: 16px;
      letter-spacing: 0.6px;
    }

    .contact-form__control,
    .contact-form__textarea {
      padding: 12px 17px;
      background: #fcfbf9;
      border-color: #d4d4d4;
      border-radius: var(--radius-md);
      font-size: 14px;
      line-height: 20px;
    }

    .contact-form__textarea {
      min-height: 102px;
      padding-top: 11px;
    }

    .contact-form__control::placeholder,
    .contact-form__textarea::placeholder {
      color: #a3a3a3;
    }

    .contact-form__error {
      font-size: 13px;
    }

    .contact-form__actions {
      align-items: center;
      padding-top: var(--space-8);
    }

    .contact-form__submit {
      width: auto;
      padding: 12px 32px;
      background: #dc2626;
      border-radius: var(--radius-pill);
      box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
      font-family: var(--font-jetbrains);
      font-weight: 600;
      font-size: 14px;
      line-height: 20px;
      letter-spacing: 0;
    }

    .contact-form__submit:hover,
    .contact-form__submit:focus-visible {
      background: #b91c1c;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form__submit,
    .contact-form__submit:hover,
    .contact-form__submit:focus-visible,
    .contact-form__submit:active,
    .contact-form__control,
    .contact-form__textarea {
      transition: none;
      transform: none;
    }
  }
</style>

<section class="contact-form" id="contacto" aria-labelledby="contact-form-heading">
  <div class="contact-form__inner">
    <header class="contact-form__header">
      <p class="contact-form__kicker">Hablemos</p>
      <h2 id="contact-form-heading" class="contact-form__hook">
        ¿Tienes algo en mente? Escríbeme.
      </h2>
      <p class="contact-form__lede">
        Cuéntame sobre tu proyecto y te respondo en menos de 24h.
      </p>
    </header>

    <form
      class="contact-form__form"
      action="https://formspree.io/f/xwlkrjjp"
      method="POST"
      accept-charset="UTF-8"
      novalidate
      oninput="clearContactError(event)"
      onfocusout="checkContactField(event)"
      onsubmit="return submitContactForm(event)"
    >
      <input type="hidden" name="_subject" value="Portafolio: nuevo mensaje" />
      <div class="contact-form__hp" aria-hidden="true">
        <label for="contact-gotcha">Sitio web</label>
        <input
          id="contact-gotcha"
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="contact-form__row">
        <div class="contact-form__field" data-field="name">
          <label class="contact-form__label" for="contact-name">Nombre</label>
          <input
            class="contact-form__control"
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            minlength="2"
            maxlength="120"
            required
            placeholder="Tu nombre o empresa"
            aria-describedby="contact-name-error"
          />
          <p class="contact-form__error" id="contact-name-error" data-error-for="name"></p>
        </div>

        <div class="contact-form__field" data-field="contact">
          <label class="contact-form__label" for="contact-email">Email o WhatsApp</label>
          <input
            class="contact-form__control"
            id="contact-email"
            name="contact"
            type="text"
            autocomplete="email"
            inputmode="email"
            minlength="5"
            maxlength="160"
            required
            pattern="^([^@\s]+@[^@\s]+\.[^@\s]{2,}|\+?[0-9][0-9\s().-]{6,24})$"
            title="Escribe un email o un número de WhatsApp."
            placeholder="tu@correo.com o +51..."
            aria-describedby="contact-email-error"
          />
          <p class="contact-form__error" id="contact-email-error" data-error-for="contact"></p>
        </div>
      </div>

      <div class="contact-form__field" data-field="message">
        <label class="contact-form__label" for="contact-message">¿En qué te puedo ayudar?</label>
        <textarea
          class="contact-form__textarea"
          id="contact-message"
          name="message"
          minlength="10"
          maxlength="4000"
          rows="3"
          required
          placeholder="Describe brevemente lo que necesitas..."
          aria-describedby="contact-message-error"
        ></textarea>
        <p class="contact-form__error" id="contact-message-error" data-error-for="message"></p>
      </div>

      <div class="contact-form__actions">
        <button class="contact-form__submit" type="submit">
          <span>Enviar mensaje</span>
          <span class="contact-form__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </div>
</section>

<script is:inline>
  const CONTACT_EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/
  const CONTACT_MESSAGES = {
    name: "Escribe tu nombre.",
    contact: "Escribe un email o un WhatsApp.",
    message: "Cuéntame un poco más (al menos 10 caracteres).",
  }

  function isContactPhone(value) {
    const digits = value.replace(/[\s().-]/g, "")
    return /^\+?[0-9]{7,15}$/.test(digits)
  }

  function contactErrorFor(name, value) {
    const trimmed = value.trim()

    if (name === "name") {
      return trimmed.length < 2 ? CONTACT_MESSAGES.name : ""
    }

    if (name === "contact") {
      return CONTACT_EMAIL.test(trimmed) || isContactPhone(trimmed)
        ? ""
        : CONTACT_MESSAGES.contact
    }

    return trimmed.length < 10 ? CONTACT_MESSAGES.message : ""
  }

  function getContactFieldName(event) {
    const field = event.target.closest("[data-field]")
    if (!field) return null

    const name = field.getAttribute("data-field")
    if (name === "name" || name === "contact" || name === "message") return name
    return null
  }

  function setContactFieldError(name, message) {
    const root = document.querySelector(`[data-field="${name}"]`)
    if (!root) return

    const error = root.querySelector("[data-error-for]")
    const input = root.querySelector("input, textarea")
    if (!error || !input) return

    if (message) {
      root.classList.add("is-invalid")
      error.textContent = message
      input.setAttribute("aria-invalid", "true")
    } else {
      root.classList.remove("is-invalid")
      error.textContent = ""
      input.removeAttribute("aria-invalid")
    }
  }

  function clearContactError(event) {
    const name = getContactFieldName(event)
    if (name) setContactFieldError(name, "")
  }

  function checkContactField(event) {
    const name = getContactFieldName(event)
    if (!name) return
    setContactFieldError(name, contactErrorFor(name, event.target.value))
  }

  function validateContactForm(form) {
    const data = new FormData(form)
    const fields = ["name", "contact", "message"]
    let firstInvalid = null

    for (const name of fields) {
      const message = contactErrorFor(name, String(data.get(name) || ""))
      setContactFieldError(name, message)

      if (message && !firstInvalid) {
        const root = document.querySelector(`[data-field="${name}"]`)
        if (root) firstInvalid = root.querySelector("input, textarea")
      }
    }

    if (firstInvalid) {
      firstInvalid.focus()
      return false
    }

    return true
  }

  function submitContactForm(event) {
    const form = event.currentTarget

    if (!validateContactForm(form)) {
      event.preventDefault()
      return false
    }

    const submit = form.querySelector(".contact-form__submit")
    if (submit) submit.disabled = true
    return true
  }
</script>
